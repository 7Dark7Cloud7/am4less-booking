{
  "name": "am4less-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AM4LESS - commercial cleaning: online booking, instant estimates, lead capture.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "photos": "node scripts/make-photos.mjs",
    "photos:sheet": "node scripts/contact-sheet.mjs",
    "icons": "node scripts/make-icons.mjs",
    "native:add": "npm run build:native && cap add android",
    "native:sync": "npm run build:native && cap sync",
    "native:open": "cap open android",
    "build:native": "tsc --noEmit && vite build --mode native",
    "native:apk": "npm run build:native && cap sync android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.5"
  }
}
